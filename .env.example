# 复制为项目根目录 .env 后按需修改
# cp .env.example .env

WEB_PORT=80
# 云上同时映射 5175，可用 http://公网IP:5175 访问
WEB_DEV_PORT=5175
POSTGRES_USER=formwise
POSTGRES_PASSWORD=ChangeMe_DbPass_123

POSTGRES_DB=formwise

JWT_SECRET=ChangeMe_JwtSecret_UseLongRandomString
JWT_EXPIRES_IN=7d

# 浏览器访问地址，多个用英文逗号分隔。使用 5175 时填 http://公网IP:5175
CORS_ORIGIN=http://localhost:5175

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 首次部署自动写入演示账号；库里已有数据则跳过。不要设成每次都全量 TRUNCATE。
SEED_IF_EMPTY=true
